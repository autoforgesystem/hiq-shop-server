# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
# Public URL of this API, used for uploaded image links
PUBLIC_URL=http://localhost:3000

# Postgres. `docker compose up -d` starts one matching this URL.
# No Docker? `npm run db:local` starts an in-process Postgres (PGlite) on port 5433: use
# postgresql://postgres:postgres@localhost:5433/postgres and DB_POOL_MAX=1 instead.
DATABASE_URL=postgresql://hiq:hiq@localhost:5432/hiq_shop
DB_POOL_MAX=10

# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Sign-in. Use a long random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CUSTOMER_TOKEN_TTL=1d
CUSTOMER_TOKEN_TTL_REMEMBER=30d
ADMIN_TOKEN_TTL=12h

# First admin user, created by `npm run db:seed` (password: 10+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=HIQ Admin

# Load demo customers (juan@example.com / demo1234) when seeding. Turn off in production.
SEED_DEMO=true

# Business settings still to be confirmed by HIQ
# Cities or provinces HIQ services, comma-separated. Empty = "HIQ will call to confirm" [TBC].
SERVICE_AREAS=
# Subscribe & Save for filters [CONFIRM SUBSCRIPTION OFFER]
SUBSCRIPTIONS_ENABLED=false
SALES_EMAIL=sales@hospitalityinnovations.com.ph

# Where admin image uploads are stored on disk (served at /uploads)
UPLOAD_DIR=uploads

# Number of proxies in front of the API (set 1 on Render, 0 locally) so rate limits see real visitor IPs
TRUST_PROXY=0
